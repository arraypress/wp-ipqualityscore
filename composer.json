{
  "name": "arraypress/wp-ipqualityscore",
  "description": "A PHP library for integrating with the IPQualityScore API in WordPress, providing proxy, VPN & email validation, phone verification, dark web monitoring, URL scanning, and fraud prevention. Features comprehensive response handling and WordPress transient caching.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-ipqualityscore/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "arraypress/wp-countries": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\IPQualityScore\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-ipqualityscore/issues",
    "source": "https://github.com/arraypress/wp-ipqualityscore"
  },
  "keywords": [
    "ipqualityscore",
    "proxy-detection",
    "vpn-detection",
    "email-validation",
    "phone-verification",
    "dark-web-monitoring",
    "url-scanning",
    "fraud-prevention",
    "wordpress",
    "ip-lookup",
    "asn",
    "security",
    "anti-fraud",
    "threat-detection",
    "email-verification",
    "data-breach",
    "leak-detection",
    "transaction-scoring"
  ],
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\IPQualityScore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
